PVE_UPSTREAM=https://pve.example.internal:8006
PVE_EXTENSION_IMAGE=pve-webui-plugins:local
# Unset = all bundled plugins; empty = no plugins. No Komodo keys needed for
# temperatures or sites. Changes take effect after recreating the container.
PVE_PLUGINS=komodo,temperatures,sites
PVE_EXTENSION_ENABLED=true
PVE_TLS_VERIFY=true
# Comma-separated full PVE user IDs; every user also needs Sys.Audit at /.
PVE_ADMIN_USERS=root@pam
# Set to a trusted CA PEM path inside the container and mount the PEM read-only.
# PVE_CA_FILE=/run/pve-ca.pem
# Default binding assumes the existing Nginx runs on this Docker host.
PVE_EXTENSION_BIND=127.0.0.1
PVE_EXTENSION_PORT=18080
# Optional overrides for non-default node_exporter addresses/ports/TLS.
# Normally node IPs are discovered from PVE and port 9100 is used automatically.
# Mount overrides read-only; see TEMPERATURES.md. No Komodo credentials required.
# PVE_TEMPERATURE_SOURCES_FILE=/run/temperatures/sources.json

# Example Docker service name. The extension and Core must share a network;
# replace this with the actual fixed HTTP(S) Core origin when necessary.
# All three values are required for the Komodo connection check to be configured.
KOMODO_URL=http://core:9120
# Leave credentials empty until API keys have been created in Komodo.
KOMODO_API_KEY=
KOMODO_API_SECRET=
KOMODO_TLS_VERIFY=true
