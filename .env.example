# First node is primary. Remaining nodes are backups from the same PVE cluster.
# HTTPS and port 8006 are automatic. IPv4:port and [IPv6]:port are also accepted.
# Explicit ports target PVE independently of gateway/App listening ports,
# e.g. 192.0.2.10:443,[2001:db8::11]:8443.
PVE_UPSTREAM=192.0.2.10,192.0.2.11
PVE_PLUGINS_IMAGE=pve-webui-plugins:local
PVE_PLUGINS_INJECTION_ENABLED=true
# PVE normally uses a self-signed certificate. Enable verification with the
# cluster CA and matching DNS certificate names for every configured node.
PVE_TLS_VERIFY=false
# Comma-separated full PVE user IDs; every user also needs Sys.Audit at /.
PVE_ADMIN_USERS=root@pam
# Mount the trusted CA PEM read-only before setting its container path.
# PVE_CA_FILE=/run/pve-ca.pem
# PVE_TLS_SERVER_NAMES=pve-a.example.internal,pve-b.example.internal

# Complete browser entry point. A self-signed HTTPS certificate is generated
# once and saved in the data volume, unless a mounted certificate pair is used.
# Container HTTPS 8006 is published on the host port selected below.
PVE_INTERNAL_PROXY_ENABLED=true
PVE_PROXY_BIND=0.0.0.0
PVE_PROXY_PORT=8006
# PVE_PROXY_CERT_FILE=/run/certs/fullchain.pem
# PVE_PROXY_KEY_FILE=/run/certs/privkey.pem
# Only these immediate proxy peers may supply X-Forwarded-Proto/For.
# PVE_TRUSTED_PROXIES=192.0.2.0/24,2001:db8:1::/64

# Container App HTTP 8008 is published on the host port selected below.
# This integration port supports a gateway that performs its own path routing.
# Set PVE_INTERNAL_PROXY_ENABLED=false to start only the App.
PVE_PLUGINS_BIND=127.0.0.1
PVE_PLUGINS_PORT=8008

# Open --插件-- in the PVE view selector after login to enable optional modules,
# configure service connections, and manage attached sites.
# Persistent state uses the pve_webui_plugins_data named volume.
# plugins.json contains credentials. Keep the volume when recreating the container.
